{
  "latex-workshop.latex.path": "/Library/TeX/texbin",
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "/Library/TeX/texbin/pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "pdfLaTeX",
      "tools": [
        "pdflatex"
      ]
    },
    {
      "name": "pdfLaTeX x2",
      "tools": [
        "pdflatex",
        "pdflatex"
      ]
    }
  ],
  "latex-workshop.texcount.path": "/Library/TeX/texbin/texcount",
  "latex-workshop.linting.chktex.exec.path": "/Library/TeX/texbin/chktex",
  "latex-utilities.countWord.path": "/Library/TeX/texbin/texcount",
  "latex.linter.enabled": false
}
